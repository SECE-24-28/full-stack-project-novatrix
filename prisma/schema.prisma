generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  WAREHOUSE_MANAGER
  INVENTORY_CLERK
  VIEWER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum TransactionType {
  PURCHASE_RECEIPT      // stock in from purchase order
  SALES_ISSUE           // stock out for sales order
  TRANSFER_IN           // stock transferred from another warehouse
  TRANSFER_OUT          // stock transferred to another warehouse
  ADJUSTMENT_IN         // manual positive correction
  ADJUSTMENT_OUT        // manual negative correction
  RETURN_IN             // customer return
  RETURN_OUT            // return to supplier
  DAMAGE_WRITE_OFF      // write-off due to damage / expiry
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCK
  EXPIRY_APPROACHING
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

// ─────────────────────────────────────────────
// User & Auth
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  inventoryTxns      InventoryTransaction[]
  acknowledgedAlerts StockAlert[]
  auditLogs          AuditLog[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// Category
// ─────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  parentId    String?   @map("parent_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

// ─────────────────────────────────────────────
// Supplier
// ─────────────────────────────────────────────

model Supplier {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  contactName   String?        @map("contact_name")
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  status        SupplierStatus @default(ACTIVE)
  paymentTerms  Int            @default(30) @map("payment_terms") // days
  gstNumber     String?        @map("gst_number")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([code])
  @@index([status])
  @@map("suppliers")
}

// ─────────────────────────────────────────────
// Product
// ─────────────────────────────────────────────

model Product {
  id              String        @id @default(uuid())
  sku             String        @unique
  name            String
  description     String?
  categoryId      String        @map("category_id")
  supplierId      String?       @map("supplier_id")
  unitOfMeasure   String        @default("EACH") @map("unit_of_measure")
  costPrice       Decimal       @map("cost_price") @db.Decimal(12, 4)
  sellingPrice    Decimal       @map("selling_price") @db.Decimal(12, 4)
  reorderPoint    Int           @default(0) @map("reorder_point")
  reorderQuantity Int           @default(0) @map("reorder_quantity")
  weight          Decimal?      @db.Decimal(8, 3)
  dimensions      String?       // JSON string: { l, w, h, unit }
  barcode         String?       @unique
  imageUrl        String?       @map("image_url")
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  category           Category              @relation(fields: [categoryId], references: [id])
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  inventoryStock     InventoryStock[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  inventoryTxns      InventoryTransaction[]
  stockAlerts        StockAlert[]

  @@index([sku])
  @@index([categoryId])
  @@index([supplierId])
  @@index([status])
  @@map("products")
}

// ─────────────────────────────────────────────
// Warehouse
// ─────────────────────────────────────────────

model Warehouse {
  id          String          @id @default(uuid())
  name        String
  code        String          @unique
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String?
  managerId   String?         @map("manager_id")
  capacity    Int?            // total capacity in units
  status      WarehouseStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  zones              WarehouseZone[]
  inventoryStock     InventoryStock[]
  inventoryTxnsFrom  InventoryTransaction[] @relation("TxnSourceWarehouse")
  inventoryTxnsTo    InventoryTransaction[] @relation("TxnDestWarehouse")
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]

  @@index([code])
  @@index([status])
  @@map("warehouses")
}

model WarehouseZone {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  name        String
  code        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryStock InventoryStock[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("warehouse_zones")
}

// ─────────────────────────────────────────────
// Inventory Stock (per product per warehouse zone)
// ─────────────────────────────────────────────

model InventoryStock {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  warehouseId String    @map("warehouse_id")
  zoneId      String?   @map("zone_id")
  quantity    Int       @default(0)
  reservedQty Int       @default(0) @map("reserved_qty")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  product   Product        @relation(fields: [productId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  zone      WarehouseZone? @relation(fields: [zoneId], references: [id])

  @@unique([productId, warehouseId, zoneId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory_stock")
}

// ─────────────────────────────────────────────
// Purchase Order
// ─────────────────────────────────────────────

model PurchaseOrder {
  id              String              @id @default(uuid())
  poNumber        String              @unique @map("po_number")
  supplierId      String              @map("supplier_id")
  warehouseId     String              @map("warehouse_id")
  createdById     String              @map("created_by_id")
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now()) @map("order_date")
  expectedDate    DateTime?           @map("expected_date")
  receivedDate    DateTime?           @map("received_date")
  subtotal        Decimal             @default(0) @db.Decimal(14, 4)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 4)
  totalAmount     Decimal             @default(0) @map("total_amount") @db.Decimal(14, 4)
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy     User               @relation(fields: [createdById], references: [id])
  items         PurchaseOrderItem[]
  inventoryTxns InventoryTransaction[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  productId        String   @map("product_id")
  orderedQty       Int      @map("ordered_qty")
  receivedQty      Int      @default(0) @map("received_qty")
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 4)
  totalCost        Decimal  @map("total_cost") @db.Decimal(14, 4)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────
// Sales Order
// ─────────────────────────────────────────────

model SalesOrder {
  id              String           @id @default(uuid())
  soNumber        String           @unique @map("so_number")
  warehouseId     String           @map("warehouse_id")
  createdById     String           @map("created_by_id")
  customerName    String           @map("customer_name")
  customerEmail   String?          @map("customer_email")
  customerPhone   String?          @map("customer_phone")
  shippingAddress String?          @map("shipping_address")
  status          SalesOrderStatus @default(DRAFT)
  orderDate       DateTime         @default(now()) @map("order_date")
  requiredDate    DateTime?        @map("required_date")
  shippedDate     DateTime?        @map("shipped_date")
  deliveredDate   DateTime?        @map("delivered_date")
  subtotal        Decimal          @default(0) @db.Decimal(14, 4)
  taxAmount       Decimal          @default(0) @map("tax_amount") @db.Decimal(14, 4)
  discountAmount  Decimal          @default(0) @map("discount_amount") @db.Decimal(14, 4)
  totalAmount     Decimal          @default(0) @map("total_amount") @db.Decimal(14, 4)
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy     User               @relation(fields: [createdById], references: [id])
  items         SalesOrderItem[]
  inventoryTxns InventoryTransaction[]

  @@index([warehouseId])
  @@index([status])
  @@index([orderDate])
  @@index([customerEmail])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String   @id @default(uuid())
  salesOrderId  String   @map("sales_order_id")
  productId     String   @map("product_id")
  orderedQty    Int      @map("ordered_qty")
  shippedQty    Int      @default(0) @map("shipped_qty")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 4)
  discountPct   Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(14, 4)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([salesOrderId, productId])
  @@index([productId])
  @@map("sales_order_items")
}

// ─────────────────────────────────────────────
// Inventory Transaction (immutable ledger)
// ─────────────────────────────────────────────

model InventoryTransaction {
  id                String          @id @default(uuid())
  productId         String          @map("product_id")
  sourceWarehouseId String?         @map("source_warehouse_id")
  destWarehouseId   String?         @map("dest_warehouse_id")
  purchaseOrderId   String?         @map("purchase_order_id")
  salesOrderId      String?         @map("sales_order_id")
  performedById     String          @map("performed_by_id")
  type              TransactionType
  quantity          Int             // always positive; direction implied by type
  quantityBefore    Int             @map("quantity_before")
  quantityAfter     Int             @map("quantity_after")
  unitCost          Decimal?        @map("unit_cost") @db.Decimal(12, 4)
  reference         String?         // external reference / batch number
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")

  product         Product        @relation(fields: [productId], references: [id])
  sourceWarehouse Warehouse?     @relation("TxnSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse?     @relation("TxnDestWarehouse", fields: [destWarehouseId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  performedBy     User           @relation(fields: [performedById], references: [id])

  @@index([productId])
  @@index([sourceWarehouseId])
  @@index([destWarehouseId])
  @@index([type])
  @@index([createdAt])
  @@index([purchaseOrderId])
  @@index([salesOrderId])
  @@map("inventory_transactions")
}

// ─────────────────────────────────────────────
// Stock Alert
// ─────────────────────────────────────────────

model StockAlert {
  id               String      @id @default(uuid())
  productId        String      @map("product_id")
  warehouseId      String?     @map("warehouse_id")
  type             AlertType
  status           AlertStatus @default(OPEN)
  threshold        Int?        // the level that triggered the alert
  currentQuantity  Int         @map("current_quantity")
  acknowledgedById String?     @map("acknowledged_by_id")
  acknowledgedAt   DateTime?   @map("acknowledged_at")
  resolvedAt       DateTime?   @map("resolved_at")
  message          String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  product        Product   @relation(fields: [productId], references: [id])
  acknowledgedBy User?     @relation(fields: [acknowledgedById], references: [id])

  @@index([productId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("stock_alerts")
}

// ─────────────────────────────────────────────
// Audit Log (append-only)
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")  // null for system-generated events
  action     AuditAction
  resource   String      // e.g. "Product", "PurchaseOrder"
  resourceId String?     @map("resource_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
